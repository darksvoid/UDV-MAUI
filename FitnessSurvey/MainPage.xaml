<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessSurvey.MainPage"
             Title="Анкета фитнес-клуба"
             BackgroundColor="#FAF4E8">

    <ScrollView x:Name="SurveyScroll"
                Orientation="Vertical">
        <VerticalStackLayout x:Name="SurveyLayout"
                             Spacing="12"
                             Padding="20,24,20,32">

            <!-- Шапка анкеты -->
            <Grid x:Name="HeaderGrid"
                  ColumnSpacing="16"
                  RowSpacing="2"
                  Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ClubLogo"
                       Grid.Row="0"
                       Grid.Column="0"
                       Grid.RowSpan="2"
                       Source="logo.png"
                       Aspect="AspectFit"
                       HeightRequest="110" />

                <Label x:Name="TitleLabel"
                       Grid.Row="0"
                       Grid.Column="1"
                       Text="Фитнес-клуб «Энергия»"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1B3A5C"
                       VerticalOptions="End" />

                <Label x:Name="SubtitleLabel"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="Анкета для записи на первую тренировку"
                       FontSize="15"
                       FontAttributes="Italic"
                       TextColor="#6E6456" />
            </Grid>

            <!-- Имя -->
            <Label x:Name="NameLabel"
                   Text="Имя и фамилия"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C"
                   Margin="0,4,0,0" />
            <Border x:Name="NameEntryBorder"
                    Stroke="#C9BCA6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FFFFFF"
                    Padding="10,2"
                    Margin="0,0,0,4">
                <Entry x:Name="NameEntry"
                       Placeholder="Например: Никита Козлов"
                       FontSize="16"
                       TextColor="#2E2A24"
                       BackgroundColor="Transparent"
                       Keyboard="Text"
                       MaxLength="40"
                       ClearButtonVisibility="WhileEditing"
                       TextChanged="OnRequiredFieldChanged" />
            </Border>

            <!-- Телефон -->
            <Label x:Name="PhoneLabel"
                   Text="Контактный телефон"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Border x:Name="PhoneEntryBorder"
                    Stroke="#C9BCA6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FFFFFF"
                    Padding="10,2"
                    Margin="0,0,0,4">
                <Entry x:Name="PhoneEntry"
                       Placeholder="+7 900 123-45-67"
                       FontSize="16"
                       TextColor="#2E2A24"
                       BackgroundColor="Transparent"
                       Keyboard="Telephone"
                       MaxLength="18"
                       ClearButtonVisibility="WhileEditing"
                       TextChanged="OnRequiredFieldChanged" />
            </Border>

            <Label x:Name="HintLabel"
                   Text="Заполните имя и телефон — без них заявку не примут"
                   FontSize="14"
                   FontAttributes="Italic"
                   TextColor="#C0392B"
                   IsVisible="True"
                   Margin="0,0,0,4" />

            <!-- Направление -->
            <Label x:Name="DirectionLabel"
                   Text="Направление тренировок"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Border x:Name="DirectionPickerBorder"
                    Stroke="#C9BCA6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FFFFFF"
                    Padding="10,6"
                    Margin="0,0,0,4">
                <Picker x:Name="DirectionPicker"
                        Title="Выберите направление"
                        TitleColor="#6E6456"
                        FontSize="16"
                        TextColor="#2E2A24"
                        BackgroundColor="Transparent">
                    <Picker.Items>
                        <x:String>Тренажёрный зал</x:String>
                        <x:String>Групповые занятия</x:String>
                        <x:String>Бассейн</x:String>
                        <x:String>Единоборства</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <!-- Уровень подготовки -->
            <Label x:Name="LevelLabel"
                   Text="Уровень подготовки"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Border x:Name="LevelBorder"
                    Stroke="#C9BCA6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FFFFFF"
                    Padding="12,8"
                    Margin="0,0,0,4">
                <VerticalStackLayout x:Name="LevelGroup"
                                     Spacing="2">
                    <RadioButton x:Name="LevelBeginner"
                                 Content="Начальный — раньше не занимался"
                                 GroupName="FitnessLevel"
                                 Value="Начальный"
                                 FontSize="16"
                                 TextColor="#2E2A24"
                                 IsChecked="True" />
                    <RadioButton x:Name="LevelMiddle"
                                 Content="Средний — занимаюсь время от времени"
                                 GroupName="FitnessLevel"
                                 Value="Средний"
                                 FontSize="16"
                                 TextColor="#2E2A24" />
                    <RadioButton x:Name="LevelAdvanced"
                                 Content="Продвинутый — тренируюсь регулярно"
                                 GroupName="FitnessLevel"
                                 Value="Продвинутый"
                                 FontSize="16"
                                 TextColor="#2E2A24" />
                </VerticalStackLayout>
            </Border>

            <!-- Дополнительные услуги -->
            <Label x:Name="ExtrasLabel"
                   Text="Дополнительно"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Border x:Name="ExtrasBorder"
                    Stroke="#C9BCA6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FFFFFF"
                    Padding="12,8"
                    Margin="0,0,0,4">
                <VerticalStackLayout x:Name="ExtrasGroup" Spacing="6">
                    <HorizontalStackLayout x:Name="TrainerRow"
                                           Spacing="8">
                        <CheckBox x:Name="TrainerCheck"
                                  IsChecked="False"
                                  Color="#E67E22"
                                  VerticalOptions="Center" />
                        <Label x:Name="TrainerCheckLabel"
                               Text="Нужен персональный тренер"
                               FontSize="16"
                               FontAttributes="None"
                               TextColor="#2E2A24"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="NewsRow"
                                           Spacing="8">
                        <CheckBox x:Name="NewsCheck"
                                  IsChecked="True"
                                  Color="#E67E22"
                                  VerticalOptions="Center" />
                        <Label x:Name="NewsCheckLabel"
                               Text="Присылать расписание и акции клуба"
                               FontSize="16"
                               FontAttributes="None"
                               TextColor="#2E2A24"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="MorningRow"
                                           Spacing="10">
                        <Switch x:Name="MorningSwitch"
                                IsToggled="False"
                                OnColor="#27AE60"
                                ThumbColor="White"
                                VerticalOptions="Center" />
                        <Label x:Name="MorningLabel"
                               Text="Удобно заниматься утром, до 12:00"
                               FontSize="16"
                               FontAttributes="None"
                               TextColor="#2E2A24"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Дата старта -->
            <Label x:Name="DateLabel"
                   Text="Желаемая дата первой тренировки"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Border x:Name="StartDateBorder"
                    Stroke="#C9BCA6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FFFFFF"
                    Padding="10,6"
                    Margin="0,0,0,4">
                <DatePicker x:Name="StartDatePicker"
                            Format="dd.MM.yyyy"
                            FontSize="16"
                            TextColor="#2E2A24"
                            BackgroundColor="Transparent"
                            Date="2026-11-02"
                            MinimumDate="2026-10-01"
                            MaximumDate="2027-03-31" />
            </Border>

            <!-- Частота тренировок -->
            <Label x:Name="VisitsTitleLabel"
                   Text="Сколько раз в неделю планируете приходить"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Slider x:Name="VisitsSlider"
                    Minimum="1"
                    Maximum="7"
                    Value="3"
                    MinimumTrackColor="#E67E22"
                    MaximumTrackColor="#B0BEC5"
                    ThumbColor="#1B3A5C"
                    Margin="0,4,0,0" />
            <Label x:Name="VisitsLabel"
                   Text="{Binding Source={x:Reference VisitsSlider}, Path=Value, Mode=OneWay, StringFormat='Выбрано: {0:F0} раз(а) в неделю'}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C"
                   Margin="0,0,0,4" />

            <!-- Комментарий -->
            <Label x:Name="CommentLabel"
                   Text="Пожелания и ограничения по здоровью"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Border x:Name="CommentEditorBorder"
                    Stroke="#C9BCA6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FFFFFF"
                    Padding="10,2"
                    Margin="0,0,0,8">
                <Editor x:Name="CommentEditor"
                        Placeholder="Травмы, хронические заболевания, удобное время занятий"
                        FontSize="16"
                        TextColor="#2E2A24"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        MaxLength="300"
                        HeightRequest="110" />
            </Border>

            <!-- Кнопки -->
            <Grid x:Name="ButtonsGrid"
                  ColumnSpacing="12"
                  Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ShowResultButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Показать результат"
                        FontSize="17"
                        BackgroundColor="#1B3A5C"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="48"
                        Clicked="OnShowResultClicked" />
                <Button x:Name="ClearButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Очистить"
                        FontSize="17"
                        BackgroundColor="#B0BEC5"
                        TextColor="#1B3A5C"
                        CornerRadius="8"
                        HeightRequest="48"
                        Clicked="OnClearClicked" />
            </Grid>

            <!-- Результат -->
            <Border x:Name="ResultBorder"
                    IsVisible="False"
                    Stroke="#1B3A5C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#FFFDF8"
                    Padding="16">
                <VerticalStackLayout x:Name="ResultLayout" Spacing="6">
                    <Label x:Name="ResultTitleLabel"
                           Text="Ваши ответы"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1B3A5C" />
                    <Label x:Name="ResultLabel"
                           Text=""
                           FontSize="15"
                           FontAttributes="None"
                           LineHeight="1.4"
                           TextColor="#2E2A24" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
