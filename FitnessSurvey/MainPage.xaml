<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessSurvey.MainPage"
             Title="Анкета фитнес-клуба"
             BackgroundColor="#F5F7FA">

    <ScrollView x:Name="SurveyScroll">
        <VerticalStackLayout x:Name="SurveyLayout"
                             Spacing="12"
                             Padding="20,24,20,32">

            <!-- Шапка анкеты -->
            <Grid x:Name="HeaderGrid"
                  ColumnSpacing="16"
                  RowSpacing="2"
                  Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ClubLogo"
                       Grid.Row="0"
                       Grid.Column="0"
                       Grid.RowSpan="2"
                       Source="logo.png"
                       Aspect="AspectFit"
                       HeightRequest="110" />

                <Label x:Name="TitleLabel"
                       Grid.Row="0"
                       Grid.Column="1"
                       Text="Фитнес-клуб «Энергия»"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1B3A5C"
                       VerticalOptions="End" />

                <Label x:Name="SubtitleLabel"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="Анкета для записи на первую тренировку"
                       FontSize="14"
                       FontAttributes="Italic"
                       TextColor="#5A6B7D" />
            </Grid>

            <!-- Имя -->
            <Label x:Name="NameLabel"
                   Text="Имя и фамилия"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C"
                   Margin="0,4,0,0" />
            <Entry x:Name="NameEntry"
                   Placeholder="Например: Никита Козлов"
                   Keyboard="Text"
                   MaxLength="40"
                   Margin="0,0,0,4" />

            <!-- Телефон -->
            <Label x:Name="PhoneLabel"
                   Text="Контактный телефон"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Entry x:Name="PhoneEntry"
                   Placeholder="+7 900 123-45-67"
                   Keyboard="Telephone"
                   MaxLength="18"
                   Margin="0,0,0,4" />

            <Label x:Name="HintLabel"
                   Text="Заполните имя и телефон — без них заявку не примут"
                   FontSize="13"
                   FontAttributes="Italic"
                   TextColor="#C0392B"
                   IsVisible="True"
                   Margin="0,0,0,4" />

            <!-- Направление -->
            <Label x:Name="DirectionLabel"
                   Text="Направление тренировок"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#1B3A5C" />
            <Picker x:Name="DirectionPicker"
                    Title="Выберите направление"
                    Margin="0,0,0,4">
                <Picker.Items>
                    <x:String>Тренажёрный зал</x:String>
                    <x:String>Групповые занятия</x:String>
                    <x:String>Бассейн</x:String>
                    <x:String>Единоборства</x:String>
                </Picker.Items>
            </Picker>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
